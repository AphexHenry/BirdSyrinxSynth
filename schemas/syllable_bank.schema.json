{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuicuiinstruments.com/schemas/syllable_bank.schema.json",
  "title": "cuicui.syllable_bank",
  "description": "A bird's real syllables (1 ms pitch and amplitude curves) grouped into its real phrases, with each syllable's note under four rules. Built by `python -m cuicui.bank`. WP-R1, decision D-026; notes set by ear and rule_used values added in WP-R5 (D-032); the optional shape model (`variation`, per-syllable `type` / `model` / `scores`) added in WP-R3 (D-036).",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "name", "contour_rate_hz", "centres_cents", "phrases"],
  "properties": {
    "format": { "const": "cuicui.syllable_bank" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "species": { "type": "string" },
    "description": { "type": "string" },
    "source": { "type": "object" },
    "contour_rate_hz": { "const": 1000 },
    "cents_reference": { "type": "string" },
    "build": { "type": "object" },
    "rules": { "type": "object", "additionalProperties": { "type": "string" } },
    "centres_cents": { "$ref": "#/$defs/per_rule" },
    "bird_centre_cents": { "type": "number" },
    "stats": { "type": "object" },
    "hash": { "type": "string" },
    "variation": {
      "description": "WP-R3 (D-036): the bird's shape model, fitted by `cuicui.variation.attach_section`. Types are clusters of renditions; a type with enough renditions has a model.",
      "type": "object",
      "required": ["format", "version", "points", "spread_median", "types"],
      "properties": {
        "format": { "const": "cuicui.variation_model" },
        "version": { "const": 1 },
        "points": { "type": "integer", "minimum": 2, "maximum": 64 },
        "settings": { "type": "object" },
        "spread_median": {
          "type": "object",
          "required": ["note", "logdur", "peak_db"],
          "properties": { "note": { "type": "number" }, "logdur": { "type": "number" }, "peak_db": { "type": "number" } }
        },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["note", "logdur", "peak_db", "mean", "modes", "mode_sd"],
            "properties": {
              "id": { "type": "integer" },
              "renditions": { "type": "integer" },
              "fitted_on": { "type": "integer" },
              "note": { "$ref": "#/$defs/mean_sd" },
              "logdur": { "$ref": "#/$defs/mean_sd" },
              "peak_db": { "$ref": "#/$defs/mean_sd" },
              "mean": { "type": "array", "items": { "type": "number" } },
              "modes": { "type": "array", "maxItems": 4, "items": { "type": "array", "items": { "type": "number" } } },
              "mode_sd": { "type": "array", "maxItems": 4, "items": { "type": "number", "minimum": 0 } }
            }
          }
        }
      }
    },
    "phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "syllables"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "start_s": { "type": "number", "minimum": 0 },
          "syllables": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/syllable" }
          }
        }
      }
    }
  },
  "$defs": {
    "mean_sd": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "per_rule": {
      "type": "object",
      "required": ["rule", "steady", "landing", "average"],
      "properties": {
        "rule": { "type": "number" },
        "steady": { "type": "number" },
        "landing": { "type": "number" },
        "average": { "type": "number" }
      }
    },
    "syllable": {
      "type": "object",
      "required": ["t_ms", "f_hz", "a", "anchors"],
      "properties": {
        "segment": { "type": "integer" },
        "label": { "type": "string" },
        "t_ms": { "type": "integer", "minimum": 0, "description": "onset relative to the phrase's first syllable" },
        "f_hz": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "description": "pitch every 1 ms"
        },
        "a": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "amplitude every 1 ms, normalised per phrase (max 1)"
        },
        "anchors": {
          "allOf": [
            { "$ref": "#/$defs/per_rule" },
            {
              "type": "object",
              "properties": {
                "rule_used": { "enum": ["steady part", "ending", "loud ending", "whole", "ear"] },
                "steady_ms": { "type": "integer", "minimum": 0 },
                "rule_span_ms": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "integer", "minimum": 0 }
                }
              }
            }
          ]
        },
        "max_step_cents": { "type": "number", "minimum": 0 },
        "flags": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "integer", "description": "WP-R3: its syllable type (cluster of renditions) within its bird" },
        "model": { "type": "integer", "minimum": 0, "description": "WP-R3: index into variation.types (its type has a model)" },
        "scores": { "type": "array", "maxItems": 4, "items": { "type": "number" }, "description": "WP-R3: its shape-mode scores" }
      }
    }
  }
}
